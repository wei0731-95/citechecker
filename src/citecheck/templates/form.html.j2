<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>書狀引用查核</title>
<style>
:root{--bg:#fff;--fg:#1f2328;--muted:#5d6670;--line:#d0d7de;--card:#f6f8fa;--accent:#0b5cad;--err:#c62828;
--green:#d1f2d6;--red:#ffd0cc;--orange:#ffe2b8;--gray:#e4e7eb}
@media (prefers-color-scheme:dark){:root{--bg:#14171a;--fg:#e6e8ea;--muted:#9aa4ad;--line:#343b42;--card:#1c2126;--accent:#6cb2ff;--err:#ff6b5e;
--green:#1d4a2a;--red:#5a2724;--orange:#5a4020;--gray:#32383e}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.75 "Noto Sans TC","Microsoft JhengHei",sans-serif}
main{max-width:1080px;margin:0 auto;padding:24px 16px 48px}
h1{font-size:1.7rem;margin:0 0 4px}
.statement{border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:6px;padding:10px 14px;background:var(--card);font-weight:600;margin:12px 0 20px}
.error{border:1px solid var(--err);border-left:5px solid var(--err);border-radius:6px;padding:10px 14px;margin:0 0 16px;font-weight:600}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:24px;align-items:start}
@media (max-width:820px){.layout{grid-template-columns:1fr}}
.step{font-weight:700;margin:0 0 6px;font-size:1.05rem}
.step .no{display:inline-block;width:1.6em;height:1.6em;line-height:1.6em;text-align:center;border-radius:50%;background:var(--accent);color:var(--bg);font-size:.9rem;margin-right:6px}
.hint{color:var(--muted);font-size:.88rem;margin:4px 0 0;line-height:1.55}
textarea{width:100%;min-height:380px;padding:12px;font:inherit;line-height:1.8;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:8px;resize:vertical}
textarea:focus{outline:3px solid var(--accent);outline-offset:1px}
.option{display:block;border:1px solid var(--line);border-radius:8px;padding:12px 14px;margin:22px 0 0;background:var(--card);cursor:pointer}
.option input{width:18px;height:18px;margin:0 8px 0 0;vertical-align:-3px}
.option .hint{margin-left:26px}
button{margin-top:22px;font:inherit;font-size:1.1rem;font-weight:700;padding:12px 32px;border-radius:8px;border:1px solid var(--accent);background:var(--accent);color:var(--bg);cursor:pointer}
button:disabled{opacity:.65;cursor:default}
aside{border:1px solid var(--line);border-radius:8px;padding:14px 16px;background:var(--card)}
aside h2{font-size:1.05rem;margin:0 0 10px}
aside dl{margin:0} aside dt{margin-top:10px} aside dd{margin:2px 0 0;color:var(--muted);font-size:.9rem;line-height:1.5}
.badge{display:inline-block;border-radius:999px;padding:1px 12px;font-size:.88rem;font-weight:700}
.green{background:var(--green)} .red{background:var(--red)} .orange{background:var(--orange)} .gray{background:var(--gray)}
</style>
</head>
<body>
<main>
<h1>書狀引用查核</h1>
<p class="statement">{{ header }}</p>
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<div class="layout">
<form method="post" action="/check" id="f">
<p class="step"><label for="text"><span class="no">1</span>貼上書狀文字</label></p>
<textarea id="text" name="text" placeholder="請貼上書狀文字（最多 50,000 字）" autofocus>{{ text }}</textarea>
<p class="hint">{{ text_hint }}</p>
<p class="step" style="margin-top:22px"><span class="no">2</span>選擇查核範圍</p>
<label class="option" style="margin-top:0"><input type="checkbox" name="l2" value="1"{% if l2 %} checked{% endif %}>{{ l2_label }}<span class="hint" style="display:block">{{ l2_hint }}</span></label>
<button type="submit" id="go">開始查核</button>
</form>
<aside>
<h2>{{ legend_title }}</h2>
<dl>{% for color, label, help in legend %}<dt><span class="badge {{ color }}">{{ label }}</span></dt><dd>{{ help }}</dd>{% endfor %}</dl>
</aside>
</div>
</main>
<script>
document.getElementById("f").addEventListener("submit", function () {
  var b = document.getElementById("go");
  b.disabled = true;
  b.textContent = "{{ busy }}";
});
</script>
</body>
</html>
